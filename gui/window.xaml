<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity · 本地汉化" Width="860" Height="760" MinWidth="740" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="18,0"/>
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#233442"/>
      <Setter Property="BorderBrush" Value="#D4DDE3"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#079F92"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#D4DDE3"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#233442"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Background="#163F42" Padding="30,22">
      <Grid>
        <StackPanel>
          <TextBlock Text="ANTIGRAVITY  /  LOCAL" FontSize="11" Foreground="#98C9C3"/>
          <TextBlock Text="让常用界面，说中文。" FontSize="26" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="14" Background="#285154" Padding="12,6">
          <TextBlock Text="本地运行 · 可恢复" Foreground="#D2E9E4" FontSize="12"/>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="28,24,28,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="客户端位置" FontWeight="SemiBold" Foreground="#233442" Margin="0,0,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
          <TextBox x:Name="PathBox" Height="42" ToolTip="留空自动检测，也可输入安装目录或 app.asar 文件路径" AutomationProperties.Name="客户端安装路径"/>
          <Button x:Name="BrowseButton" Grid.Column="2" Content="浏览…" ToolTip="选择 Antigravity.exe 或 app.asar"/>
        </Grid>
        <TextBlock Text="留空时自动查找；也可以选择 Antigravity.exe 或 app.asar。" Foreground="#667984" FontSize="12" Margin="0,8,0,18"/>
      </StackPanel>
      <Border Grid.Row="1" Background="White" BorderBrush="#E0E6EB" BorderThickness="1" CornerRadius="10" Padding="20,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#86969F" Margin="0,0,9,0"/>
              <TextBlock x:Name="StatusTitle" Text="正在识别客户端" FontSize="19" FontWeight="SemiBold" Foreground="#233442"/>
            </StackPanel>
            <TextBlock x:Name="StatusDetail" Text="首次打开只检查状态，不会安装补丁。" TextWrapping="Wrap" Foreground="#667984" Margin="18,9,14,0"/>
            <TextBlock x:Name="VersionLabel" Text="支持版本 2.12.2" Foreground="#667984" FontSize="12" Margin="18,10,0,0"/>
          </StackPanel>
          <Button x:Name="CheckButton" Grid.Column="1" Content="重新检查" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <StackPanel Grid.Row="2" Margin="0,18,0,18">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="InstallButton" Content="安装汉化" Background="#177A70" Foreground="White" BorderBrush="#177A70" Width="160" Height="46" IsEnabled="False"/>
          <Button x:Name="RestoreButton" Content="恢复英文" Width="140" Height="46" Margin="12,0,0,0" IsEnabled="False"/>
        </StackPanel>
        <TextBlock Text="操作前请保存工作并完全退出 Antigravity；完成后手动重新打开。" Foreground="#667984" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Grid Grid.Row="3">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="操作记录" FontWeight="SemiBold" Foreground="#233442" Margin="0,0,0,10"/>
        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontSize="12" Background="#ECF0F3" BorderThickness="0"
                 AutomationProperties.Name="操作记录"/>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#E0E6EB" BorderThickness="0,1,0,0" Padding="28,0">
      <Grid><TextBlock Text="常用控件汉化 · 未知版本停止写入" Foreground="#667984" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock x:Name="ActivityLabel" Text="就绪" Foreground="#177A70" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
